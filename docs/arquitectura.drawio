ace=wrap;html=1;fixedSize=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="250" height="70" as="geometry"/></mxCell><mxCell id="c3" value="sin índice sobre la columna" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="250" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Hash extensible&lt;br&gt;1–2 accesos a disco&lt;br&gt;sin orden · sin rangos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="70" width="280" height="90" as="geometry"/></mxCell><mxCell id="c5" value="B+ no agrupado&lt;br&gt;hoja con RIDs → un fetch por fila" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="280" height="80" as="geometry"/></mxCell><mxCell id="c6" value="B+ agrupado&lt;br&gt;los registros viven en la hoja" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="280" height="80" as="geometry"/></mxCell><mxCell id="c7" value="TableScan&lt;br&gt;heap (llegada) o secuencial (ordenado)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="500" width="280" height="90" as="geometry"/></mxCell><mxCell id="c8" value="1º el que NO soporta rangos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="85" width="300" height="45" as="geometry"/></mxCell><mxCell id="c9" value="2º si no hay, cualquiera disponible" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="215" width="300" height="45" as="geometry"/></mxCell><mxCell id="c10" value="exige supports_range = True" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="335" width="300" height="45" as="geometry"/></mxCell><mxCell id="c11" value="recorre el archivo completo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="300" height="45" as="geometry"/></mxCell><mxCell id="c12" value="preferido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="alternativa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c1" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Comparación experimental 2.1.6&lt;br&gt;&lt;br&gt;Mismo dataset de arXiv: 1 000 / 10 000 / 100 000 registros.&lt;br&gt;Por técnica: construcción, consulta, espacio en disco y&lt;br&gt;sobre todo disk_reads y disk_writes.&lt;br&gt;Mediana de 5 corridas: la primera está contaminada por&lt;br&gt;el caché del sistema operativo." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="520" height="170" as="geometry"/></mxCell><mxCell id="c22" value="Por qué el hash no simula rangos&lt;br&gt;&lt;br&gt;Un scan disfrazado escondería que el hash no ordena.&lt;br&gt;El planner necesita saberlo para elegir B+ en un BETWEEN." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="660" width="460" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
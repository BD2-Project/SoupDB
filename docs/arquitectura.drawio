mxGeometry x="40" y="50" width="700" height="380" as="geometry"/></mxCell><mxCell id="c2" value="Página 0 · metadatos&lt;br&gt;magic · versión · profundidad global&lt;br&gt;profundidad máxima · páginas del directorio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="c1"><mxGeometry x="20" y="45" width="300" height="80" as="geometry"/></mxCell><mxCell id="c3" value="Páginas de directorio&lt;br&gt;2^gd entradas de 4 bytes&lt;br&gt;se lee solo la entrada necesaria" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="c1"><mxGeometry x="20" y="145" width="300" height="80" as="geometry"/></mxCell><mxCell id="c4" value="Páginas de bucket&lt;br&gt;cabecera: profundidad local · nº entradas&lt;br&gt;offset libre · id de overflow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="c1"><mxGeometry x="350" y="45" width="320" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Entrada: [len clave][clave][page_id][slot]&lt;br&gt;clave = etiqueta de tipo + payload" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="c1"><mxGeometry x="350" y="145" width="320" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Cadena de overflow&lt;br&gt;solo al tocar la profundidad máxima" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c1"><mxGeometry x="350" y="225" width="320" height="55" as="geometry"/></mxCell><mxCell id="c7" value="int → el valor es el hash (como en el laboratorio)&lt;br&gt;str → blake2b, determinista entre sesiones" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;shadow=0;arcSize=8;f